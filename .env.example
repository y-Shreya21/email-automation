# ==============================================================================
# Automated HR Email Outreach System - Environment Configuration Template
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' file or credentials to Git!
# ==============================================================================

# Candidate Profile Configuration
CANDIDATE_NAME="Shreya Yadav"
CANDIDATE_DEGREE="B.Tech in Computer Science and Engineering"
CANDIDATE_COLLEGE="Computer Science Department"
CANDIDATE_GRAD_YEAR="2027"
TARGET_ROLE="Software Engineering / AI-ML Intern"

# Candidate Contact Information (Kept private in local .env)
CANDIDATE_PHONE="+91 0000000000"
CANDIDATE_EMAIL="candidate@example.com"

# Portfolio & Links
CANDIDATE_GITHUB="https://github.com/your-username"
CANDIDATE_LINKEDIN="https://www.linkedin.com/in/your-profile/"
CANDIDATE_PORTFOLIO="https://your-portfolio.example.com/"

# Path to Resume PDF (Optional - defaults to resume.pdf in workspace root)
# CANDIDATE_RESUME_PATH="resume.pdf"

# Google Cloud OAuth Credential Paths (Optional custom locations)
# GMAIL_CREDENTIALS_PATH="credentials.json"
# GMAIL_TOKEN_PATH="token.json"

# Anti-Spam Safeguards & Rate Limits
MAX_EMAILS_PER_DAY=50
MIN_JITTER_SECONDS=20
MAX_JITTER_SECONDS=45
