# Python virtual environment
venv/
env/
ENV/
*.venv

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment secrets & local config
.env
.env.*
*.env
!.env.example

# Sensitive Google Cloud & Gmail API credentials (DO NOT COMMIT)
credentials.json
client_secret*.json
token.json
*.token

# Recruiter spreadsheets & candidate data (DO NOT COMMIT)
*.xlsx
*.xls
*.csv
!sample_recruiter_contacts.xlsx
data/*.xlsx
data/*.xls
data/*.csv
data/outreach_history.db*
data/outreach.log
data/suppression_list.json
resume.pdf
*.pdf

# Generated HTML dashboards & reports (contains personalized recipient bodies)
reports/*.html
!reports/.gitkeep

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# IDE / Editor configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
